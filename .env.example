# Copy this file to .env.local for local development, and add the same values
# in Vercel under Project → Settings → Environment Variables.

# Public address of the site, used for Stripe return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3360

# ── Stripe (deposits) ─────────────────────────────────────────────────────
# Leave these empty to run without payments: bookings go straight through and
# are marked as test bookings.
# Dashboard → Developers → API keys. Use sk_test_... while testing.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → add endpoint
#   https://<your-domain>/api/stripe/webhook  (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# ── Supabase (saves bookings and photos) ──────────────────────────────────
# Project Settings → API. Run supabase/migrations/0001_bookings.sql first.
# The service role key is secret: never put it in a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (emails to the office and customer) ────────────────────────────
# resend.com → API Keys. Verify your domain in Resend before going live.
RESEND_API_KEY=
EMAIL_FROM="Plumbing360 <bookings@plumbing360.nz>"
# Where new booking emails go
OFFICE_EMAIL=

# ── Fergus (creates an enquiry for each booking) ──────────────────────────
# A Personal Access Token from your Fergus account.
FERGUS_API_TOKEN=

# ── Owner dashboard (/dashboard) ──────────────────────────────────────────
# The password for logging in. Use something long. Changing it logs everyone out.
# Without it, the dashboard stays locked on the live site.
DASHBOARD_PASSWORD=

# ── Booking engine (books the time automatically) ────────────────────────
# The AI booking engine's Supabase project (not the site's own one above):
# Project Settings → API. With these set, Priority and Standard bookings get a
# real time straight away and Flexi bookings join the standby pool. Leave empty
# and the office books times by hand, as before.
ENGINE_SUPABASE_URL=
ENGINE_SUPABASE_SERVICE_ROLE_KEY=
# Google Maps "server" key (Geocoding API and Routes API). Finds the job on the
# map and looks up real drive times for route planning.
GOOGLE_MAPS_SERVER_KEY=
# Any long random string. Vercel sends it with the daily drive-times job
# (vercel.json → /api/cron/drive-times); without it that job is refused.
CRON_SECRET=
# Optional: most Google drive-time lookups per day (cost cap). Default 500.
# DRIVE_TIMES_DAILY_LIMIT=500

# ── Xero (invoices into Xero, payments back) ──────────────────────────────
# developer.xero.com → My Apps → New app (Web app). Redirect URI:
#   https://<your-site>/api/xero/callback
# Then connect from the office console: /dashboard/office/xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# ── Marketing: publishing approved posts and ads (Marketing page) ─────────
# Each channel switches on when its keys are set; without them, approved
# wording waits on the Marketing page for you to post by hand.
# Facebook page posts (Meta Business Suite → page → long-lived Page access token
# with pages_manage_posts):
META_PAGE_ID=
META_PAGE_TOKEN=
# Instagram posts: the Instagram business account linked to that page
# (instagram_content_publish permission on the same token):
META_IG_USER_ID=
# Facebook/Instagram ads: ad account id (digits only) and a System User token
# with ads_management (Business Settings → Users → System users):
META_AD_ACCOUNT_ID=
META_ADS_TOKEN=
# Optional: Graph API version (default v23.0)
# META_GRAPH_VERSION=v23.0
# Google Business Profile updates. Google must approve the Cloud project for
# the Business Profile APIs first; then an OAuth client and a refresh token for
# your Google login (scope https://www.googleapis.com/auth/business.manage):
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
