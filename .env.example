# Copy this file to .env.local for local development, and add the same values
# in Vercel under Project → Settings → Environment Variables.

# Public address of the site, used for Stripe return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3360

# ── Stripe (deposits) ─────────────────────────────────────────────────────
# Leave these empty to run without payments: bookings go straight through and
# are marked as test bookings.
# Dashboard → Developers → API keys. Use sk_test_... while testing.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → add endpoint
#   https://<your-domain>/api/stripe/webhook  (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
